# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local dev: postgresql://postgres:postgres@localhost:5432/wit_dev
# Production: injected by hosting provider (Railway / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wit_dev"

# ─── App ──────────────────────────────────────────────────────────────────────
# Used by Next.js to set the public site URL (required for auth callbacks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"

# ─── Auth (add when implementing NextAuth / Clerk) ────────────────────────────
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"
