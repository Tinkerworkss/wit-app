# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local dev: postgresql://postgres:postgres@localhost:5432/wit_dev
# Production: injected by hosting provider (Railway / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wit_dev"

# ─── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# ─── App ──────────────────────────────────────────────────────────────────────
# Used by Next.js to set the public site URL (required for auth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"
