generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model — full meat inventory schema added in WIT-4
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
